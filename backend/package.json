{
  "name": "nutritrack-backend",
  "version": "1.0.0",
  "description": "NutriTrack API",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc -p .",
    "dev": "tsx watch server.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "NODE_ENV=test tsx --test test/*.test.ts",
    "db:validate": "DATABASE_URL=postgresql://x prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "data:import-ifct": "tsx scripts/importIfct.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.11",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
